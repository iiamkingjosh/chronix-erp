# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
#
# Client — Firebase Web SDK (`src/lib/firebase.ts`, `src/lib/user-setup.ts`)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — unlock `/setup/create-user` when set to exactly `true`
# NEXT_PUBLIC_ENABLE_SETUP_BOOTSTRAP=true

# Server-only — Firebase Admin (`src/lib/firebase-admin.ts`, `DELETE /api/admin/users/[uid]`)
# Omit these only if you use Application Default Credentials (e.g. GCP) everywhere.
# For `.env.local`, put the private key in quotes and use \\n for line breaks (Firebase convention).
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
