rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /** Canonical role string on users/{uid}. Keep aliases aligned with src/types/roles.ts ROLE_ALIASES */
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAuth() {
      return request.auth != null;
    }
    function tokenEmail() {
      return request.auth.token.email;
    }

    function isCEO() {
      return role() == 'CEO' || role() == 'Manager';
    }
    function isCFO() {
      return role() == 'CFO' || role() == 'Finance' || role() == 'Accountant';
    }
    function isSystemAdmin() {
      return role() == 'System Admin' || role() == 'Admin' || role() == 'Super Admin';
    }
    function isBrandLead() {
      return role() == 'Brand Lead';
    }
    function isSocialLead() {
      return role() == 'Social Media Lead';
    }
    function isHR() {
      return role() == 'HR';
    }
    function isStaffLike() {
      return role() == 'Staff' || role() == 'Support' || role() == 'Employee' || role() == 'User';
    }
    function isClientRole() {
      return role() == 'Client';
    }
    function isSalesRep() {
      return role() == 'Sales Rep';
    }
    function isProjectManager() {
      return role() == 'Project Manager';
    }
    function isFinanceOfficer() {
      return role() == 'Finance Officer';
    }
    function isITManager() {
      return role() == 'IT Manager';
    }
    function isInternalStaff() {
      return !isClientRole();
    }

    /** App: CEO + System Admin have view:all (read-most dashboards). */
    function hasViewAll() {
      return isCEO() || isSystemAdmin();
    }

    /** ROLE_PERMISSIONS — manage:crm */
    function canManageCRM() {
      return isSystemAdmin() || isBrandLead() || isSocialLead();
    }

    /** ROLE_PERMISSIONS — manage:hr */
    function canManageHR() {
      return isSystemAdmin() || isHR();
    }

    /** ROLE_PERMISSIONS — manage:procurement — System Admin only */
    function canManageProcurement() {
      return isSystemAdmin();
    }

    /** ROLE_PERMISSIONS — manage:subscriptions */
    function canManageSubscriptions() {
      return isCFO() || isSystemAdmin();
    }

    /** ROLE_PERMISSIONS — manage:staff */
    function canManageStaff() {
      return isSystemAdmin();
    }

    /** ROLE_PERMISSIONS — manage:tax (CFO only — CEO views but does not manage) */
    function canManageTax() {
      return isCFO();
    }

    function canManageFinance() {
      return isCFO() || isSystemAdmin() || isFinanceOfficer();
    }
    function canManageTickets() {
      return isCFO() || isSystemAdmin() || isProjectManager() || isITManager();
    }
    function canManageProjects() {
      return isSystemAdmin() || isBrandLead() || isProjectManager();
    }

    function hasViewFinance() {
      return hasViewAll() || isCFO() || isFinanceOfficer() || isSalesRep();
    }

    function hasViewTickets() {
      return hasViewAll() || isCFO() || canManageTickets() ||
        isBrandLead() || isSocialLead() || isHR() || isStaffLike() ||
        isProjectManager() || isITManager();
    }

    function hasViewCrm() {
      return hasViewAll() || isCFO() || canManageCRM() ||
        isHR() || isStaffLike() || isSalesRep() || isProjectManager();
    }

    function hasViewProjects() {
      return hasViewAll() || isCFO() || isBrandLead() || isSocialLead() ||
        isHR() || isStaffLike() || isProjectManager() || isITManager() || isSalesRep();
    }

    function hasViewProcurement() {
      return hasViewAll() || isCFO() || isFinanceOfficer();
    }

    function hasViewSubscriptions() {
      return hasViewAll() || isCFO() || isFinanceOfficer() || isITManager() || isSalesRep();
    }

    function hasViewHr() {
      return hasViewAll() || isCFO() || isHR() || isStaffLike() || isProjectManager();
    }

    /** view:tax — CEO (view only), CFO (view + manage), System Admin (view only) */
    function hasViewTax() {
      return isCEO() || isCFO() || isSystemAdmin();
    }

    /** view:paye — CEO, CFO, HR */
    function hasViewPAYE() {
      return isCEO() || isCFO() || isHR();
    }

    /** Matches dashboard CRM reads + CEO KPI safeDocs — broad listing queries require broad reads */
    function canReadClientsDirectory() {
      return hasViewCrm();
    }

    /** Employee roster lives on users docs — HR modules + staffing dropdowns + exec KPIs */
    function canReadUserDirectory() {
      return hasViewAll() || canManageHR() || canManageStaff() ||
        canManageTickets() || hasViewHr() || isITManager() || isProjectManager();
    }

    /** src/types/roles.ts — canDeleteUnpaidInvoice */
    function canDeleteUnpaidInvoice() {
      return isCFO() || isSystemAdmin();
    }

    function userPortalBillingMatches(resourceBillingKey) {
      let me = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return (tokenEmail() != null && resourceBillingKey == tokenEmail()) ||
        (me.get('portalBillingCompany', '') != '' &&
          me.get('portalBillingCompany', '') == resourceBillingKey) ||
        (me.get('portalBillingName', '') != '' &&
          me.get('portalBillingName', '') == resourceBillingKey) ||
        (me.get('portalBillingEmail', '') != '' &&
          me.get('portalBillingEmail', '') == resourceBillingKey);
    }

    /* ── Users ────────────────────────────────────────────── */
    match /users/{userId} {
      allow read:   if isAuth() && (
        request.auth.uid == userId ||
        canReadUserDirectory()
      );
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && (
        request.auth.uid == userId ||
        canManageHR() ||
        isCFO() ||
        canManageStaff()
      );
      allow delete: if false;
    }

    /* ── Invoices ─────────────────────────────────────────── */
    match /invoices/{invoiceId} {
      allow read: if hasViewFinance() || (
        isClientRole() &&
        resource.data.client != null &&
        resource.data.client.name != null &&
        userPortalBillingMatches(resource.data.client.name)
      );
      allow create: if canManageFinance() || isSalesRep();
      allow update: if canManageFinance();
      allow delete: if canDeleteUnpaidInvoice() && resource.data.status != 'paid';
    }

    /* ── Payments ─────────────────────────────────────────── */
    match /payments/{paymentId} {
      allow read: if hasViewFinance();
      allow create: if canManageFinance();
      allow update, delete: if false;
    }

    /* ── Tickets ──────────────────────────────────────────── */
    match /tickets/{ticketId} {
      allow read: if hasViewTickets() || (
        isClientRole() &&
        resource.data.client != null &&
        resource.data.client.name != null &&
        userPortalBillingMatches(resource.data.client.name)
      );
      allow create: if canManageTickets() || (
        isClientRole() &&
        request.resource.data.status == 'open' &&
        request.resource.data.client != null &&
        request.resource.data.client.name != null &&
        userPortalBillingMatches(request.resource.data.client.name)
      );
      allow update: if canManageTickets() || (
        isAuth() && resource.data.assignedTo == request.auth.uid
      );
      allow delete: if false;
    }

    /* ── CRM — Leads ──────────────────────────────────────── */
    match /leads/{leadId} {
      allow read: if hasViewCrm();
      allow create: if canManageCRM();
      allow update: if canManageCRM() || resource.data.assignedTo == request.auth.uid;
      allow delete: if false;
    }

    /* ── CRM — Clients ────────────────────────────────────── */
    match /clients/{clientId} {
      allow read: if canReadClientsDirectory() || (
        isClientRole() &&
        resource.data.email != null &&
        tokenEmail() != null &&
        resource.data.email == tokenEmail()
      );
      allow create, update: if canManageCRM();
      allow delete: if false;
    }

    /* ── Projects ─────────────────────────────────────────── */
    match /projects/{projectId} {
      allow read: if hasViewProjects();
      allow create: if canManageProjects();
      allow update: if canManageProjects() || resource.data.createdBy == request.auth.uid;
      allow delete: if false;
    }

    /* ── Vendors ──────────────────────────────────────────── */
    match /vendors/{vendorId} {
      allow read: if hasViewProcurement();
      allow create, update: if canManageProcurement();
      allow delete: if false;
    }

    /* ── Purchase Orders ──────────────────────────────────── */
    match /purchase_orders/{poId} {
      allow read: if hasViewProcurement();
      allow create, update: if canManageProcurement();
      allow delete: if false;
    }

    /* ── Employees ────────────────────────────────────────── */
    match /employees/{employeeId} {
      allow read: if request.auth.uid == employeeId || hasViewHr() || canManageHR() || isCFO();
      allow create, update: if canManageHR();
      allow delete: if false;
    }

    /* ── Payroll Runs ─────────────────────────────────────── */
    match /payroll_runs/{runId} {
      allow read: if canManageHR() || isCFO() || isSystemAdmin();
      allow create, update: if canManageHR() || isSystemAdmin();
      allow delete: if false;
    }

    /* ── Subscriptions ────────────────────────────────────── */
    match /subscriptions/{subId} {
      allow read: if hasViewSubscriptions() || (
        isClientRole() &&
        resource.data.clientName != null &&
        userPortalBillingMatches(resource.data.clientName)
      );
      allow create, update: if canManageSubscriptions();
      allow delete: if false;
    }

    /* ── Notifications ────────────────────────────────────── */
    match /notifications/{notifId} {
      allow read: if isAuth() && !isClientRole();
      allow create: if isAuth() && !isClientRole();
      allow update: if isAuth() && !isClientRole();
      allow delete: if false;
    }

    /* ── Tax Rules (managed directly in Firestore Console) ── */
    match /tax_rules/{ruleId} {
      allow read: if isAuth() && hasViewTax();
      allow create, update, delete: if isAuth() && canManageTax();
    }

    /* ── VAT Records ──────────────────────────────────────── */
    match /vat_records/{recordId} {
      allow read: if isAuth() && hasViewTax();
      allow create, update: if isAuth() && canManageTax();
      allow delete: if false;
    }

    /* ── Withholding Tax ──────────────────────────────────── */
    match /withholding_tax/{recordId} {
      allow read: if isAuth() && hasViewTax();
      allow create, update: if isAuth() && canManageTax();
      allow delete: if false;
    }

    /* ── PAYE / Payroll Tax ───────────────────────────────── */
    match /payroll_tax/{recordId} {
      allow read: if isAuth() && hasViewPAYE();
      allow create, update: if isAuth() && canManageTax();
      allow delete: if false;
    }

    /* ── Tax Reports ──────────────────────────────────────── */
    match /tax_reports/{reportId} {
      allow read: if isAuth() && hasViewTax();
      allow create, update: if isAuth() && canManageTax();
      allow delete: if false;
    }

    /* ── Expenses ────────────────────────────────────────── */
    match /expenses/{expenseId} {
      allow read: if isAuth() && (
        hasViewAll() || isCFO() || isSystemAdmin() ||
        resource.data.submittedByUid == request.auth.uid
      );
      allow create: if isAuth() && !isClientRole();
      allow update: if isAuth() && (isCFO() || isSystemAdmin() || isCEO());
      allow delete: if false;
    }

    /* ── Leave Requests ──────────────────────────────────── */
    match /leave_requests/{leaveId} {
      allow read: if isAuth() && (
        canManageHR() || isCEO() ||
        resource.data.employeeUid == request.auth.uid
      );
      allow create: if isAuth() && !isClientRole();
      allow update: if isAuth() && (
        canManageHR() || isCEO() ||
        resource.data.employeeUid == request.auth.uid
      );
      allow delete: if false;
    }

    /* ── Disciplinary Records ────────────────────────────── */
    match /disciplinary_records/{discId} {
      allow read:   if isAuth() && (canManageHR() || isCEO());
      allow create: if isAuth() && (canManageHR() || isCEO());
      allow update: if isAuth() && (canManageHR() || isCEO());
      allow delete: if false;
    }

    /* ── Assets ──────────────────────────────────────────── */
    match /assets/{assetId} {
      allow read: if isAuth() && !isClientRole();
      allow create, update: if isAuth() && (isSystemAdmin() || isCEO() || canManageHR() || isITManager());
      allow delete: if false;
    }

    /* ── Time Entries ────────────────────────────────────── */
    match /time_entries/{entryId} {
      allow read: if isAuth() && (
        hasViewAll() || isCFO() || isSystemAdmin() ||
        resource.data.employeeUid == request.auth.uid
      );
      allow create: if isAuth() && !isClientRole();
      allow update, delete: if false;
    }

    /* ── Audit Logs ──────────────────────────────────────── */
    match /audit_logs/{logId} {
      allow read:   if isAuth() && (isCEO() || isSystemAdmin());
      allow create: if isAuth() && !isClientRole();
      allow update, delete: if false;
    }

    /* ── Knowledge Base ──────────────────────────────────── */
    match /knowledge_base/{articleId} {
      allow read: if isAuth() && !isClientRole();
      allow create, update: if isAuth() && (isSystemAdmin() || isCEO() || isITManager());
      allow delete: if false;
    }

    /* ── Change Log ──────────────────────────────────────── */
    match /change_log/{changeId} {
      allow read: if isAuth() && !isClientRole();
      allow create: if isAuth() && !isClientRole();
      allow update: if isAuth() && (isSystemAdmin() || isCEO() || isCFO() || isITManager());
      allow delete: if false;
    }

    /* ── Incidents ───────────────────────────────────────── */
    match /incidents/{incidentId} {
      allow read: if isAuth() && !isClientRole();
      allow create: if isAuth() && !isClientRole();
      allow update: if isAuth() && !isClientRole();
      allow delete: if false;
    }

    /* ── On-Call Schedule ────────────────────────────────── */
    match /oncall_schedule/{slotId} {
      allow read: if isAuth() && !isClientRole();
      allow create, delete: if isAuth() && (isSystemAdmin() || canManageHR() || isCEO() || isITManager());
      allow update: if false;
    }

    /* ── Brand Assets ────────────────────────────────────── */
    match /brand_assets/{assetId} {
      allow read: if isAuth() && !isClientRole();
      allow create, update: if isAuth() && (isBrandLead() || isSystemAdmin() || isCEO());
      allow delete: if isAuth() && (isBrandLead() || isSystemAdmin() || isCEO());
    }

    /* ── Content Posts ───────────────────────────────────── */
    match /content_posts/{postId} {
      allow read: if isAuth() && !isClientRole();
      allow create, update: if isAuth() && (isBrandLead() || isSocialLead() || isSystemAdmin() || isCEO());
      allow delete: if false;
    }

    /* ── Campaigns ───────────────────────────────────────── */
    match /campaigns/{campaignId} {
      allow read: if isAuth() && !isClientRole();
      allow create, update: if isAuth() && (isBrandLead() || isSystemAdmin() || isCEO());
      allow delete: if false;
    }

    /* ── Email Campaigns ─────────────────────────────────── */
    match /email_campaigns/{campaignId} {
      allow read: if isAuth() && (isBrandLead() || isSystemAdmin() || isCEO() || isCFO());
      allow create, update: if isAuth() && (isBrandLead() || isSystemAdmin() || isCEO());
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

