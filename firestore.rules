rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /** Canonical role string on users/{uid}. Keep aliases aligned with src/types/roles.ts ROLE_ALIASES */
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAuth() {
      return request.auth != null;
    }
    function tokenEmail() {
      return request.auth.token.email;
    }

    function isCEO() {
      return role() == 'CEO' || role() == 'Manager';
    }
    function isRootAdmin() {
      return role() == 'Root Admin' || role() == 'Chronix Root' || role() == 'Root';
    }
    function isCFO() {
      return role() == 'CFO' || role() == 'Finance' || role() == 'Accountant';
    }
    function isSystemAdmin() {
      return role() == 'System Admin' || role() == 'Admin' || role() == 'Super Admin';
    }
    function isBrandLead() {
      return role() == 'Brand Lead';
    }
    function isSocialLead() {
      return role() == 'Social Media Lead';
    }
    function isHR() {
      return role() == 'HR';
    }
    function isStaffLike() {
      return role() == 'Staff' || role() == 'Support' || role() == 'Employee' || role() == 'User';
    }
    function isSalesRep() {
      return role() == 'Sales Rep';
    }
    function isProjectManager() {
      return role() == 'Project Manager';
    }
    function isFinanceOfficer() {
      return role() == 'Finance Officer';
    }
    function isITManager() {
      return role() == 'IT Manager';
    }
    function isExecutiveAssistant() {
      return role() == 'Executive Assistant';
    }

    /** App: CEO + System Admin + Executive Assistant have view:all (read-most dashboards).
        EA is read-only — never add it to a create/update/delete rule. */
    function hasViewAll() {
      return isRootAdmin() || isCEO() || isSystemAdmin() || isExecutiveAssistant();
    }

    /** ROLE_PERMISSIONS — manage:crm */
    function canManageCRM() {
      return isRootAdmin() || isSystemAdmin() || isBrandLead() || isSocialLead() || isSalesRep();
    }

    /** ROLE_PERMISSIONS — manage:hr */
    function canManageHR() {
      return isRootAdmin() || isSystemAdmin() || isHR();
    }

    /** ROLE_PERMISSIONS — manage:procurement — System Admin only */
    function canManageProcurement() {
      return isRootAdmin() || isSystemAdmin();
    }

    /** ROLE_PERMISSIONS — manage:subscriptions */
    function canManageSubscriptions() {
      return isRootAdmin() || isCFO() || isSystemAdmin();
    }

    /** ROLE_PERMISSIONS — manage:staff */
    function canManageStaff() {
      return isRootAdmin() || isSystemAdmin();
    }

    /** ROLE_PERMISSIONS — manage:tax (CFO only — CEO views but does not manage) */
    function canManageTax() {
      return isRootAdmin() || isCFO();
    }

    function canManageFinance() {
      return isRootAdmin() || isCEO() || isCFO() || isSystemAdmin() || isFinanceOfficer();
    }
    /** Narrower than canManageFinance() — CEO and Finance Officer can view
     * and approve finance data but do not SET budgets. */
    function canSetBudget() {
      return isRootAdmin() || isCFO() || isSystemAdmin();
    }
    function canManageTickets() {
      return isRootAdmin() || isCFO() || isSystemAdmin() || isProjectManager() || isITManager();
    }
    function canManageProjects() {
      return isRootAdmin() || isSystemAdmin() || isBrandLead() || isProjectManager();
    }

    /** Allow internal staff to update only the files array (for file attachments).
     * Takes the already-computed hasViewProjects() check as a parameter
     * rather than re-deriving it - see isProjectsSelfServiceUpdate(). */
    function isFilesOnlyUpdate(canSelfService) {
      return canSelfService &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['files', 'updatedAt']);
    }

    /** Allow any internal staff to update the tasks array, computed progress,
     * and the project status auto-derived from it.
     *
     * KNOWN ACCEPTED GAP: this does not currently enforce that `status` only
     * rides alongside a genuine `tasks`+`progress` write - a crafted raw
     * write of just {status, updatedAt} would also pass. Every membership
     * check tried to close this (hasAll, hasAny, the `in` operator, with and
     * without a shared `let`) reproducibly threw an "evaluation error" the
     * moment it tested for the key 'progress' specifically - isolated down
     * to that single check failing on its own, cause not understood. Tracked
     * as its own follow-up investigation rather than abandoned. Accepted as
     * low severity: internal-staff-only, requires bypassing the UI with a
     * crafted Firestore call, affects only that one project's own status
     * display, no financial/cross-tenant exposure - and the real app code
     * (addTask()/setTaskStatus()) always sends tasks+progress+status
     * together correctly regardless. */
    function isTeamMemberTaskUpdate(canSelfService) {
      return canSelfService &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tasks', 'progress', 'status', 'updatedAt']);
    }

    /** Allow any internal staff to update only the project activity log. */
    function isTeamMemberActivityUpdate(canSelfService) {
      return canSelfService &&
        request.resource.data.diff(resource.data)
          .affectedKeys().hasOnly(['activity', 'updatedAt']);
    }

    /** hasViewProjects() alone ORs together 8 role checks, several of which
     * themselves OR multiple role() calls. The three functions above used to
     * each independently recompute this same chain, tripling its cost for any
     * write that falls through to the self-service path - confirmed via the
     * emulator to exceed Firestore's 1000-expression-evaluation ceiling once
     * wrapped in a transaction (which itself evaluates the rule twice). This
     * computes it once via `let` and reuses it - same permission semantics,
     * roughly a third of the expression cost for this portion. */
    function isProjectsSelfServiceUpdate() {
      let canSelfService = hasViewProjects();
      return isFilesOnlyUpdate(canSelfService) ||
        isTeamMemberTaskUpdate(canSelfService) ||
        isTeamMemberActivityUpdate(canSelfService);
    }

    function hasViewFinance() {
      return hasViewAll() || isCFO() || isFinanceOfficer() || isSalesRep();
    }

    function hasViewTickets() {
      return hasViewAll() || isCFO() || canManageTickets() ||
        isBrandLead() || isSocialLead() || isHR() || isStaffLike() ||
        isProjectManager() || isITManager();
    }

    function hasViewCrm() {
      return hasViewAll() || isCFO() || canManageCRM() ||
        isSalesRep() || isProjectManager();
    }

    function hasViewProjects() {
      return hasViewAll() || isCFO() || isBrandLead() || isSocialLead() ||
        isStaffLike() || isProjectManager() || isITManager() || isSalesRep();
    }

    function hasViewProcurement() {
      return hasViewAll() || isCFO() || isFinanceOfficer();
    }

    function hasViewSubscriptions() {
      return hasViewAll() || isCFO() || isFinanceOfficer() || isITManager() || isSalesRep();
    }

    function hasViewHr() {
      return hasViewAll() || isCFO() || isHR() || isStaffLike() || isProjectManager();
    }

    /** Same as hasViewHr() but WITHOUT isStaffLike() or isCFO() — the
        employees collection holds bank account details. A plain Staff role
        should not be able to read arbitrary employees/{id} docs the way
        they can read the (less sensitive) basic user directory, and CFO has
        no current need for direct employees-collection access either (no
        disbursement feature exists yet, and CFO was already removed from
        individual payslip access). hasViewHr() is also used by
        canReadUserDirectory() below, where both Staff and CFO visibility
        ARE intended, so this is scoped narrowly here rather than changing
        hasViewHr() itself. */
    function hasViewHrSensitive() {
      return hasViewAll() || isHR() || isProjectManager();
    }

    /** view:tax — CEO (view only), CFO (view + manage), System Admin (view only), Executive Assistant (view only) */
    function hasViewTax() {
      return isRootAdmin() || isCEO() || isCFO() || isSystemAdmin() || isExecutiveAssistant();
    }

    /** view:paye — CEO, CFO, HR, Executive Assistant */
    function hasViewPAYE() {
      return isRootAdmin() || isCEO() || isCFO() || isHR() || isExecutiveAssistant();
    }

    /** Matches dashboard CRM reads + CEO KPI safeDocs — broad listing queries require broad reads */
    function canReadClientsDirectory() {
      return hasViewCrm();
    }

    /** Employee roster lives on users docs — HR modules + staffing dropdowns + exec KPIs */
    function canReadUserDirectory() {
      return hasViewAll() || canManageHR() || canManageStaff() ||
        canManageTickets() || hasViewHr() || isITManager() || isProjectManager();
    }

    /** src/types/roles.ts — canDeleteUnpaidInvoice */
    function canDeleteUnpaidInvoice() {
      return isRootAdmin() || isCFO() || isSystemAdmin();
    }

    /** Root-breakglass role strings — only System Admin / Root Admin may assign or revoke */
    function rootLikeRole(r) {
      return r == 'Root Admin' || r == 'Chronix Root' || r == 'Root';
    }

    function involvesRootRoleChange() {
      let oldR = resource.data.get('role', '');
      let newR = request.resource.data.get('role', '');
      return oldR != newR && (rootLikeRole(newR) || rootLikeRole(oldR));
    }

    /** Self-serve updates: profile cosmetics only (no RBAC / payroll / portal keys). */
    function userSelfCosmeticKeysOnly() {
      let k = request.resource.data.diff(resource.data).affectedKeys();
      return k.hasOnly(['displayName']) || k.hasOnly(['photoURL']) || k.hasOnly(['lastLoginAt'])
        || k.hasOnly(['displayName', 'photoURL']) || k.hasOnly(['displayName', 'lastLoginAt'])
        || k.hasOnly(['photoURL', 'lastLoginAt'])
        || k.hasOnly(['displayName', 'photoURL', 'lastLoginAt']);
    }

    function privilegedUserManagers() {
      return canManageHR() || canManageStaff();
    }

    /** First-login bootstrap doc created by the client — Staff only, email must match Auth token. */
    function userBootstrapCreateValid() {
      return request.resource.data.uid == request.auth.uid
        && request.resource.data.role == 'Staff'
        && tokenEmail() != null
        && request.resource.data.email == tokenEmail()
        && (
          request.resource.data.keys().hasOnly([
            'uid', 'email', 'displayName', 'role', 'createdAt', 'lastLoginAt'
          ])
          || request.resource.data.keys().hasOnly([
            'uid', 'email', 'displayName', 'role', 'createdAt', 'lastLoginAt', 'department'
          ])
          || request.resource.data.keys().hasOnly([
            'uid', 'email', 'displayName', 'role', 'createdAt', 'lastLoginAt', 'photoURL'
          ])
          || request.resource.data.keys().hasOnly([
            'uid', 'email', 'displayName', 'role', 'createdAt', 'lastLoginAt',
            'department', 'photoURL'
          ])
        );
    }

    /* ── Users ────────────────────────────────────────────── */
    match /users/{userId} {
      allow read:   if isAuth() && (
        request.auth.uid == userId ||
        canReadUserDirectory()
      );
      allow create: if isAuth() && request.auth.uid == userId && userBootstrapCreateValid();
      allow update: if isAuth() && (
        (request.auth.uid == userId && userSelfCosmeticKeysOnly()) ||
        (privilegedUserManagers() && (!involvesRootRoleChange() || canManageStaff()))
      );
      allow delete: if false;
    }

    /* ── Invoices ─────────────────────────────────────────── */
    match /invoices/{invoiceId} {
      allow read: if hasViewFinance();
      allow create: if canManageFinance() || isSalesRep();
      /** Whoever created the invoice may always report the outcome of the
          journal-posting side-effect from that same creation call — e.g. a
          Sales Rep (who can create invoices but isn't canManageFinance())
          must be able to write _journalPosted/_journalError on their own
          invoice. Creator-scoped, not role-scoped, and only these two
          fields — not a blanket re-opening of `update`. */
      allow update: if canManageFinance() || (
        isAuth() &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['_journalPosted', '_journalError'])
      );
      allow delete: if canDeleteUnpaidInvoice() && resource.data.status != 'paid';
    }

    /* ── Payments ─────────────────────────────────────────── */
    match /payments/{paymentId} {
      allow read: if hasViewFinance();
      allow create: if canManageFinance();
      allow update: if canManageFinance() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["_journalPosted", "_journalError"]);
      allow delete: if false;
    }

    /* ── Tickets ──────────────────────────────────────────── */
    match /tickets/{ticketId} {
      allow read: if hasViewTickets();
      allow create: if canManageTickets();
      allow update: if canManageTickets() ||
        (isAuth() && resource.data.assignedTo == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["status", "resolution", "activity", "updatedAt", "resolvedAt", "notes", "closedAt"]));
      allow delete: if false;
    }

    /* ── CRM — Leads ──────────────────────────────────────── */
    match /leads/{leadId} {
      allow read: if hasViewCrm();
      allow create: if canManageCRM();
      allow update: if canManageCRM() ||
        (resource.data.assignedTo == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["followUpNotes", "nextFollowUpDate", "activity", "lastContactedAt", "updatedAt"]));
      allow delete: if false;
    }

    /* ── CRM — Clients ────────────────────────────────────── */
    match /clients/{clientId} {
      allow read: if canReadClientsDirectory();
      allow create, update: if canManageCRM();
      allow delete: if false;
    }

    /* ── Projects ─────────────────────────────────────────── */
    match /projects/{projectId} {
      allow read: if hasViewProjects();
      allow create: if canManageProjects();
      /* Ordered cheapest-and-most-common first: a direct field comparison
       * (no get()) beats canManageProjects() (4 role()-backed checks), which
       * beats the self-service path (~20 role()-backed checks, now computed
       * once instead of three times - see isProjectsSelfServiceUpdate()).
       * Pure short-circuit ordering - || is commutative, so this changes
       * nothing about which writes are allowed, only how cheaply the
       * decision is reached. */
      allow update: if resource.data.createdBy == request.auth.uid
        || canManageProjects() || isProjectsSelfServiceUpdate();
      allow delete: if isRootAdmin();
    }

    /* ── Vendors ──────────────────────────────────────────── */
    match /vendors/{vendorId} {
      allow read: if hasViewProcurement();
      allow create, update: if canManageProcurement();
      allow delete: if false;
    }

    /* ── Purchase Orders ──────────────────────────────────── */
    match /purchase_orders/{poId} {
      allow read:   if hasViewProcurement();
      allow create: if canManageProcurement();
      /** Once "paid", createPOJournalEntry() has already posted — total,
          vatAmount, vendorCategory, and items can't change without
          desyncing from that entry. Status progression, notes, and the
          journal-flag bookkeeping fields remain writable after that. */
      allow update: if canManageProcurement() && (
        resource.data.status != 'paid' ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'notes', 'updatedAt', '_journalPosted', '_journalError'])
      );
      /** Safe by construction: createPOJournalEntry() is only ever called
          from the "paid" transition in updatePOStatus() — anything short
          of "paid" was never posted to the ledger, so deleting it has
          nothing to unwind. A "paid" PO's journal entry is immutable, same
          as every other posted entry, so it can never be deleted. */
      allow delete: if canManageProcurement() && resource.data.status != 'paid';
    }

    /* ── Payroll Runs ─────────────────────────────────────── */
    match /payroll_runs/{runId} {
      allow read: if canManageHR() || isSystemAdmin();
      allow create, update: if canManageHR() || isSystemAdmin();
      allow delete: if false;
    }

    /* ── Performance Reviews ─────────────────────────────────── */
    match /performance_reviews/{reviewId} {
      allow read: if isAuth() && (
        canManageHR() || isCEO() || isExecutiveAssistant() ||
        request.auth.uid == resource.data.employeeId
      );
      allow write: if isAuth() && (canManageHR() || isCEO());
      allow delete: if false;
    }

    /* ── Subscriptions ────────────────────────────────────── */
    match /subscriptions/{subId} {
      allow read: if hasViewSubscriptions();
      allow create, update: if canManageSubscriptions();
      allow delete: if false;
    }

    /* ── Notifications ────────────────────────────────────── */
    match /notifications/{notifId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      allow delete: if false;
    }

    /* ── Tax Rules (managed directly in Firestore Console) ── */
    match /tax_rules/{ruleId} {
      allow read: if isAuth() && hasViewTax();
      allow create, update, delete: if isAuth() && canManageTax();
    }

    /* ── VAT Records ──────────────────────────────────────── */
    match /vat_records/{recordId} {
      allow read: if isAuth() && hasViewTax();
      allow create, update: if isAuth() && canManageTax();
      allow delete: if false;
    }

    /* ── Withholding Tax ──────────────────────────────────── */
    match /withholding_tax/{recordId} {
      allow read:   if isAuth() && hasViewTax();
      allow create: if isAuth() && canManageTax();
      /** Once a bill is "paid" its journal entry is posted — the amount,
          category, and vendor that produced that entry can't change
          without desyncing from the ledger. Only cert/notes bookkeeping
          and the journal-flag fields remain writable after that point.
          markWHTPaid() itself (status: pending → paid) is exactly the one
          update this restriction has to allow through, since it's still
          being called while status == 'pending' in resource.data. */
      allow update: if isAuth() && canManageTax() && (
        resource.data.status != 'paid' ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['certStatus', 'notes', 'updatedAt', '_journalPosted', '_journalError'])
      );
      /** Safe by construction: a "pending" bill was never posted to the
          ledger (see auto-journal.ts createWHTJournalEntry — only called
          from markWHTPaid), so deleting it has nothing to unwind. A "paid"
          bill's journal entry is immutable, same as every other posted
          entry, so it can never be deleted. */
      allow delete: if isAuth() && canManageTax() && resource.data.status != 'paid';
    }

    /* ── PAYE / Payroll Tax ───────────────────────────────── */
    match /payroll_tax/{recordId} {
      allow read: if isAuth() && hasViewPAYE();
      allow create, update: if isAuth() && canManageTax();
      allow delete: if false;
    }

    /* ── Tax Reports ──────────────────────────────────────── */
    match /tax_reports/{reportId} {
      allow read: if isAuth() && hasViewTax();
      allow create, update: if isAuth() && canManageTax();
      allow delete: if false;
    }

    /* ── Expenses ────────────────────────────────────────── */
    match /expenses/{expenseId} {
      allow read: if isAuth() && (
        hasViewAll() || isCFO() || isSystemAdmin() ||
        resource.data.submittedByUid == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if isAuth() && (isRootAdmin() || isCFO() || isSystemAdmin() || isCEO());
      allow delete: if false;
    }

    /* ── Expense Budgets — one annual figure per category ─── */
    // Write gated to canSetBudget() (narrower than canManageFinance() —
    // excludes CEO and Finance Officer). Read matches hasViewFinance(),
    // the same broad gate vat_returns uses, so reporting works for
    // everyone who can already see finance reports today.
    match /expense_budgets/{budgetId} {
      allow read:   if isAuth() && hasViewFinance();
      allow create, update: if isAuth() && canSetBudget();
      allow delete: if false;
    }

    /* ── Leave Requests ──────────────────────────────────── */
    match /leave_requests/{leaveId} {
      allow read: if isAuth() && (
        canManageHR() || isCEO() || isExecutiveAssistant() ||
        resource.data.employeeUid == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if isAuth() && (
        canManageHR() || isCEO() ||
        (resource.data.employeeUid == request.auth.uid &&
         resource.data.status == "pending" &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["status", "updatedAt"]) &&
         request.resource.data.status == "cancelled")
      );
      allow delete: if false;
    }

    /* ── Disciplinary Records ────────────────────────────── */
    match /disciplinary_records/{discId} {
      allow read:   if isAuth() && (canManageHR() || isCEO() || isExecutiveAssistant());
      allow create: if isAuth() && (canManageHR() || isCEO());
      allow update: if isAuth() && (canManageHR() || isCEO());
      allow delete: if false;
    }

    /* ── Assets ──────────────────────────────────────────── */
    match /assets/{assetId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && (isSystemAdmin() || isCEO() || canManageHR() || isITManager());
      allow delete: if false;
    }

    /* ── Time Entries ────────────────────────────────────── */
    match /time_entries/{entryId} {
      /* HR added to match time/page.tsx's own canViewAll gate exactly
       * (isRootAdmin || manage:hr || CEO || CFO || System Admin) - Root
       * Admin/CEO already covered via hasViewAll(), CFO/System Admin
       * already explicit here; HR was the one role the UI grants that
       * this rule didn't (D7) - narrow fix, not a blanket widening. */
      allow read: if isAuth() && (
        hasViewAll() || isCFO() || isSystemAdmin() || isHR() ||
        resource.data.employeeUid == request.auth.uid
      );
      allow create: if isAuth();
      allow update: if isAuth() &&
        resource.data.employeeUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isVoided']);
      allow delete: if false;
    }

    /* ── Audit Logs ──────────────────────────────────────── */
    match /audit_logs/{logId} {
      allow read:   if isAuth() && (isRootAdmin() || isCEO() || isSystemAdmin() || isExecutiveAssistant());
      allow create: if isAuth();
      allow update, delete: if false;
    }

    /* ── Knowledge Base ──────────────────────────────────── */
    match /knowledge_base/{articleId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && (isRootAdmin() || isSystemAdmin() || isCEO() || isITManager());
      allow delete: if false;
    }

    /* ── Change Log ──────────────────────────────────────── */
    match /change_log/{changeId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (isRootAdmin() || isSystemAdmin() || isCEO() || isCFO() || isITManager());
      allow delete: if false;
    }

    /* ── Incidents ───────────────────────────────────────── */
    match /incidents/{incidentId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (
        isRootAdmin() || isSystemAdmin() || isCEO() || isCFO() || isITManager() ||
        resource.data.createdBy == request.auth.uid
      );
      allow delete: if false;
    }

    /* ── On-Call Schedule ────────────────────────────────── */
    match /oncall_schedule/{slotId} {
      allow read: if isAuth();
      allow create, delete: if isAuth() && (isRootAdmin() || isSystemAdmin() || canManageHR() || isCEO() || isITManager());
      allow update: if false;
    }

    /* ── Brand Assets ────────────────────────────────────── */
    match /brand_assets/{assetId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && (isRootAdmin() || isBrandLead() || isSystemAdmin() || isCEO());
      allow delete: if isAuth() && (isRootAdmin() || isBrandLead() || isSystemAdmin() || isCEO());
    }

    /* ── Content Posts ───────────────────────────────────── */
    match /content_posts/{postId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && (isRootAdmin() || isBrandLead() || isSocialLead() || isSystemAdmin() || isCEO());
      allow delete: if false;
    }

    /* ── Campaigns ───────────────────────────────────────── */
    match /campaigns/{campaignId} {
      allow read: if isAuth();
      allow create, update: if isAuth() && (isRootAdmin() || isBrandLead() || isSystemAdmin() || isCEO());
      allow delete: if false;
    }

    /* ── Email Campaigns ─────────────────────────────────── */
    match /email_campaigns/{campaignId} {
      allow read: if isAuth() && (isRootAdmin() || isBrandLead() || isSystemAdmin() || isCEO() || isCFO());
      allow create, update: if isAuth() && (isRootAdmin() || isBrandLead() || isSystemAdmin() || isCEO());
      allow delete: if false;
    }

    /* ── Chart of Accounts ───────────────────────────── */
    match /chart_of_accounts/{accountId} {
      allow read:   if isAuth();
      allow create: if isAuth() && (isRootAdmin() || isCFO() || isSystemAdmin());
      allow update: if isAuth() && (isRootAdmin() || isCFO() || isSystemAdmin());
      allow delete: if false;
    }

    /* ── Journal Entries ─────────────────────────────── */
    match /journal_entries/{entryId} {
      allow read:   if isAuth() && hasViewFinance();
      /** HR can run payroll (payroll_runs: canManageHR() || isSystemAdmin())
          but isn't in canManageFinance() — this is a narrow exception for
          the journal entry payroll itself produces, not general finance
          access. Scoped to referenceType == "payroll" only; HR still
          cannot create an invoice/payment/manual journal entry directly. */
      allow create: if isAuth() && (
        canManageFinance() || isSalesRep() ||
        (isHR() && request.resource.data.referenceType == "payroll")
      );
      /** Only the specific posted->void transition voidJournalEntry() performs —
          not a blanket unlock. The reversing entry it also posts goes through
          `create` above, which already permits this same role set. */
      allow update: if isAuth() && canManageFinance() &&
        resource.data.status == 'posted' &&
        request.resource.data.status == 'void' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'voidedBy', 'voidedAt', 'voidReason']);
      allow delete: if false; // Never allow deletes - void instead
    }

    /* ── VAT Returns ─────────────────────────────────── */
    match /vat_returns/{returnId} {
      allow read:   if isAuth() && hasViewFinance();
      allow create: if isAuth() && (isRootAdmin() || isCFO());
      allow update: if isAuth() && (isRootAdmin() || isCFO());
      allow delete: if false;
    }

    /* ── Metadata Counters (invoice, journal, expense numbers) ── */
    // runTransaction requires both read + write on the counter doc.
    // Finance team and sales reps generate numbers client-side.
    // HR's exception is scoped to journalCounter_* docs only (createJournalEntry's
    // getNextJournalNumber(), needed to post payroll's journal entry) — HR still
    // cannot touch invoice/expense counters, same narrow-exception principle as
    // the journal_entries create rule below.
    match /metadata/{docId} {
      allow read:   if isAuth() && (canManageFinance() || isSalesRep() || (isHR() && docId.matches('journalCounter_.*')));
      allow write:  if isAuth() && (canManageFinance() || isSalesRep() || (isHR() && docId.matches('journalCounter_.*')));
    }
    /* ── Employee Number Counter ─────────────────────── */
    // assignEmployeeNumber() (hr-service.ts) runs a transaction against
    // counters/employeeNumber, requiring both read + write on the same
    // doc — same shape as the metadata counters above, but scoped to
    // whoever can actually reach createEmployee() (the "Add Employee"
    // page is gated to hasPermission(role, "manage:hr") app-side), not
    // copied from metadata's Finance-role scope, which has no relation
    // to HR/employee creation.
    match /counters/{counterId} {
      allow read:   if isAuth() && canManageHR();
      allow write:  if isAuth() && canManageHR();
    }
    /* ── Push Tokens ─────────────────────────────────── */
    match /push_tokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    /* ── Personal Tasks ──────────────────────────────── */
    // The first genuinely zero-override collection in this app: scoped
    // entirely to createdBy == the signed-in user, with no manager,
    // HR, or admin read/write path of any kind. The catch-all below
    // would otherwise still let Root Admin in (it matches every path
    // not explicitly excluded) - explicitly carved out there too.
    match /personal_tasks/{taskId} {
      allow read:   if isAuth() && resource.data.createdBy == request.auth.uid;
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuth() && resource.data.createdBy == request.auth.uid;
      allow delete: if isAuth() && resource.data.createdBy == request.auth.uid;
    }

    // Split off the first path segment as its own plain-string wildcard
    // (same as {taskId}/{docId} elsewhere in this file) instead of trying
    // to string-compare {document=**}'s capture, which binds to Firestore's
    // `path` type - not a string, and not list-indexable either. In
    // rules_version 2 a trailing recursive wildcard matches zero or more
    // segments, so {collection}/{document=**} still covers every path the
    // original bare {document=**} did. Excluding personal_tasks here is
    // required, not optional: Firestore unions every matching rule for a
    // path, so without it Root Admin would still reach personal_tasks
    // through this catch-all regardless of the no-override rule above.
    match /{collection}/{document=**} {
      allow read, write: if isAuth() && isRootAdmin() && collection != 'personal_tasks';
    }
  }
}


