{
  "name": "chronix-os",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "node --max-old-space-size=6144 ./node_modules/next/dist/bin/next dev --webpack",
    "dev:turbopack": "node --max-old-space-size=6144 ./node_modules/next/dist/bin/next dev --turbopack",
    "build": "node --max-old-space-size=6144 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "typecheck": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next typegen && node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "check-env": "node scripts/check-env.mjs",
    "verify": "npm run check-env && npm run typecheck && npm run lint:strict && npm run build",
    "test": "vitest run",
    "test:emulator": "node scripts/run-emulator-tests.mjs",
    "git:fetch": "node scripts/git-run.mjs fetch origin",
    "git:pull": "node scripts/git-run.mjs pull origin master",
    "git:push": "node scripts/git-run.mjs push origin master",
    "postinstall": "node scripts/patch-react-pdf-reconciler.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@react-pdf/renderer": "^4.5.1",
    "@types/react-pdf": "^6.2.0",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "firebase": "^10.12.4",
    "firebase-admin": "^13.8.0",
    "next": "^16.2.4",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.52.2",
    "resend": "^6.12.3",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@next/bundle-analyzer": "^16.2.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.4",
    "firebase-tools": "^15.22.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
